{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "API Requests",
      "targets": [{"expr": "sum(http_server_requests_seconds_count)", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "P95 Latency",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le)) * 1000", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ms"}},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0}
    },
    {
      "type": "stat",
      "title": "5xx Rate",
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0}
    },
    {
      "type": "stat",
      "title": "JVM Heap",
      "targets": [{"expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Request Rate",
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count[1m]))", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}
    },
    {
      "type": "timeseries",
      "title": "P95 Latency by Endpoint",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri)) * 1000", "legendFormat": "{{uri}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ms"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}
    }
  ],
  "schemaVersion": 41,
  "title": "AtlasShard API",
  "version": 2
}
